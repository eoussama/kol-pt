{
  "name": "kol-pt",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "description": "KOL Patreon Tracker is a browser extension for Chrome, Edge, Firefox and Safari that helps you track KingOfLightning (KOL) reactions on Patreon. KOL is an Anime/Manga YouTuber who mostly does One Piece content and other reactions and theories.",
  "author": "EOussama",
  "license": "MIT",
  "homepage": "https://github.com/EOussama/kol-pt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EOussama/kol-pt.git"
  },
  "bugs": {
    "url": "https://github.com/EOussama/kol-pt/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-addon",
    "safari-extension",
    "patreon",
    "kol"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox && pnpm build:safari",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox && pnpm zip:safari",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"require('node:fs').rmSync('.output',{recursive:true,force:true})\"",
    "lint": "pnpm exec dx lint",
    "lint:fix": "pnpm exec dx lint --fix",
    "prod": "pnpm audit && pnpm lint && pnpm typecheck && pnpm test && pnpm clean && pnpm zip:all"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eoussama/core": "^0.0.4",
    "@eoussama/firemitt": "^0.1.8",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@vimeo/player": "^2.30.2",
    "base-64": "^1.0.0",
    "firebase": "^12.15.0",
    "millify": "^6.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^6.30.4",
    "utf8": "^3.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/base-64": "^1.0.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/utf8": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.1",
    "sass": "^1.105.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "wxt": "^0.21.4"
  }
}

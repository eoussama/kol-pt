{
  "name": "kol-pt",
  "type": "module",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "description": "KOL Patreon Tracker is a browser extension for Chrome, Edge, Firefox and Safari that helps you track KingOfLightning (KOL) reactions on Patreon. KOL is an Anime/Manga YouTuber who mostly does One Piece content and other reactions and theories.",
  "author": "EOussama",
  "license": "MIT",
  "homepage": "https://github.com/EOussama/kol-pt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EOussama/kol-pt.git"
  },
  "bugs": {
    "url": "https://github.com/EOussama/kol-pt/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-addon",
    "safari-extension",
    "patreon",
    "kol"
  ],
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "pnpm build && pnpm build:edge && pnpm build:firefox && pnpm build:safari",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "zip:all": "pnpm zip && pnpm zip:edge && pnpm zip:firefox && pnpm zip:safari",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:coverage",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "clean": "node -e \"require('node:fs').rmSync('.output',{recursive:true,force:true})\"",
    "lint": "pnpm exec dx lint",
    "lint:fix": "pnpm exec dx lint --fix",
    "check": "pnpm audit && pnpm lint && pnpm typecheck && pnpm test && pnpm clean && pnpm zip:all"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@eoussama/core": "^0.1.2",
    "@eoussama/firemitt": "^0.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@vimeo/player": "^2.30.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "lucide-react": "^1.59.0",
    "millify": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eoussama/dx": "^0.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
